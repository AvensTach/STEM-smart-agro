<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:SmartAgro.Shared;assembly=SmartAgro.Shared"
             x:Class="SmartAgro.Frontend.MainPage"
             Title="SmartAgro Control Center"
             BackgroundColor="#F0F4F1">

    <Grid RowDefinitions="Auto, *" Padding="16" RowSpacing="14">

        <!-- ВЕРХНЯ ПАНЕЛЬ: Статус підключення + Перемикач автооновлення -->
        <Border Grid.Row="0" BackgroundColor="White" StrokeShape="RoundRectangle 14" Stroke="Transparent" Padding="16,12">
            <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="12" VerticalOptions="Center">
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                    <Label Text="🌱 SmartAgro Дашборд" FontSize="20" FontAttributes="Bold" TextColor="#1B4332"/>
                    <Label x:Name="ConnectionStatusLabel" Text="Підключення до сервера..." FontSize="12" TextColor="#6C757D"/>
                </VerticalStackLayout>

                <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="6">
                    <Label Text="Live (5с)" VerticalOptions="Center" FontSize="13" FontAttributes="Bold" TextColor="#2D6A4F"/>
                    <Switch x:Name="AutoRefreshSwitch" IsToggled="True" OnColor="#40916C" Toggled="OnAutoRefreshToggled"/>
                </HorizontalStackLayout>

                <Button Grid.Column="2"
                        Text="🔄 Оновити"
                        Clicked="OnRefreshClicked"
                        BackgroundColor="#2D6A4F"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        HeightRequest="40"
                        Padding="14,0"/>
            </Grid>
        </Border>

        <!-- ОСНОВНИЙ КОНТЕНТ -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="14">

                <!-- 1. РОЗУМНИЙ ІНДИКАТОР СТАНУ ТЕПЛИЦІ (Змінює колір динамічно) -->
                <Border x:Name="AlertBanner" BackgroundColor="#D8F3DC" StrokeShape="RoundRectangle 12" Stroke="#95D5B2" Padding="14">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12" VerticalOptions="Center">
                        <Label x:Name="AlertIcon" Text="✅" FontSize="26" VerticalOptions="Center"/>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label x:Name="AlertTitle" Text="Мікроклімат у нормі" FontSize="16" FontAttributes="Bold" TextColor="#1B4332"/>
                            <Label x:Name="AlertSubtitle" Text="Усі показники знаходяться в оптимальних межах." FontSize="13" TextColor="#2D6A4F"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- 2. ПОТОЧНІ ПОКАЗНИКИ З ВІЗУАЛЬНИМИ ШКАЛАМИ -->
                <Grid ColumnDefinitions="*, *, *" ColumnSpacing="12">
                    <!-- Картка Температури -->
                    <Border Grid.Column="0" BackgroundColor="White" StrokeShape="RoundRectangle 14" Stroke="#E9ECEF" Padding="14">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="🌡️ Температура" FontSize="13" TextColor="#6C757D" FontAttributes="Bold"/>
                            <Label x:Name="CurrentTempLabel" Text="-- °C" FontSize="24" FontAttributes="Bold" TextColor="#1B4332"/>
                            <ProgressBar x:Name="TempProgressBar" Progress="0.5" ProgressColor="#E63946"/>
                            <Label Text="Норма: 18–28 °C" FontSize="11" TextColor="#ADB5BD"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Картка Вологості -->
                    <Border Grid.Column="1" BackgroundColor="White" StrokeShape="RoundRectangle 14" Stroke="#E9ECEF" Padding="14">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="💧 Вологість ґрунту" FontSize="13" TextColor="#6C757D" FontAttributes="Bold"/>
                            <Label x:Name="CurrentHumLabel" Text="-- %" FontSize="24" FontAttributes="Bold" TextColor="#0077B6"/>
                            <ProgressBar x:Name="HumProgressBar" Progress="0.5" ProgressColor="#0096C7"/>
                            <Label Text="Норма: 45–75 %" FontSize="11" TextColor="#ADB5BD"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Картка Освітлення -->
                    <Border Grid.Column="2" BackgroundColor="White" StrokeShape="RoundRectangle 14" Stroke="#E9ECEF" Padding="14">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="☀️ Освітлення" FontSize="13" TextColor="#6C757D" FontAttributes="Bold"/>
                            <Label x:Name="CurrentLightLabel" Text="-- lx" FontSize="24" FontAttributes="Bold" TextColor="#D97706"/>
                            <ProgressBar x:Name="LightProgressBar" Progress="0.5" ProgressColor="#F59E0B"/>
                            <Label Text="Макс: 1000 lx" FontSize="11" TextColor="#ADB5BD"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- 3. ІНТЕРАКТИВНИЙ БЛОК: РУЧНЕ ТЕСТУВАННЯ / ВІДПРАВКА ДАНИХ (POST) -->
                <Border BackgroundColor="White" StrokeShape="RoundRectangle 14" Stroke="#E9ECEF" Padding="14">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="🎛️ Ручний симулятор датчика (POST-запит)" FontSize="15" FontAttributes="Bold" TextColor="#1B4332"/>
                                <Label Text="Перевір реакцію системи на критичні показники вручну" FontSize="12" TextColor="#6C757D"/>
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    x:Name="ToggleSimulatorBtn"
                                    Text="Розгорнути ▼"
                                    Clicked="OnToggleSimulatorClicked"
                                    BackgroundColor="#E8F5E9"
                                    TextColor="#2D6A4F"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    CornerRadius="8"
                                    HeightRequest="34"/>
                        </Grid>

                        <!-- Панель з повзунками (прихована за замовчуванням) -->
                        <VerticalStackLayout x:Name="SimulatorPanel" IsVisible="False" Spacing="10" Padding="0,8,0,0">
                            <BoxView HeightRequest="1" Color="#E9ECEF"/>

                            <!-- Слайдер температури -->
                            <Grid ColumnDefinitions="150, *, 65" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="Температура:" VerticalOptions="Center" FontSize="13"/>
                                <Slider Grid.Column="1" x:Name="SimTempSlider" Minimum="5" Maximum="45" Value="24" MinimumTrackColor="#E63946" ValueChanged="OnSimSliderChanged"/>
                                <Label Grid.Column="2" x:Name="SimTempValueLabel" Text="24.0 °C" FontAttributes="Bold" HorizontalTextAlignment="End" VerticalOptions="Center"/>
                            </Grid>

                            <!-- Слайдер вологості -->
                            <Grid ColumnDefinitions="150, *, 65" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="Вологість ґрунту:" VerticalOptions="Center" FontSize="13"/>
                                <Slider Grid.Column="1" x:Name="SimHumSlider" Minimum="10" Maximum="95" Value="55" MinimumTrackColor="#0096C7" ValueChanged="OnSimSliderChanged"/>
                                <Label Grid.Column="2" x:Name="SimHumValueLabel" Text="55.0 %" FontAttributes="Bold" HorizontalTextAlignment="End" VerticalOptions="Center"/>
                            </Grid>

                            <!-- Слайдер світла -->
                            <Grid ColumnDefinitions="150, *, 65" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="Рівень світла:" VerticalOptions="Center" FontSize="13"/>
                                <Slider Grid.Column="1" x:Name="SimLightSlider" Minimum="50" Maximum="1000" Value="500" MinimumTrackColor="#F59E0B" ValueChanged="OnSimSliderChanged"/>
                                <Label Grid.Column="2" x:Name="SimLightValueLabel" Text="500 lx" FontAttributes="Bold" HorizontalTextAlignment="End" VerticalOptions="Center"/>
                            </Grid>

                            <Button Text="🚀 Відправити показники в базу"
                                    Clicked="OnSendCustomReadingClicked"
                                    BackgroundColor="#1B4332"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    CornerRadius="10"
                                    HeightRequest="42"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- 4. ФІЛЬТРИ ТА ІСТОРІЯ ЗАПИСІВ (З КЛІКАБЕЛЬНИМИ КАРТКАМИ) -->
                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center" Margin="0,4,0,0">
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="📋 Історія телеметрії" FontSize="17" FontAttributes="Bold" TextColor="#1B4332"/>
                        <Label Text="Натисни на будь-який запис для детального аналізу" FontSize="12" TextColor="#6C757D"/>
                    </VerticalStackLayout>

                    <!-- Кнопки швидкої фільтрації -->
                    <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                        <Button x:Name="FilterAllBtn" Text="Всі" Clicked="OnFilterAllClicked" BackgroundColor="#2D6A4F" TextColor="White" FontSize="12" HeightRequest="34" CornerRadius="8" Padding="12,0"/>
                        <Button x:Name="FilterHotBtn" Text="🔥 Спека (>28°C)" Clicked="OnFilterHotClicked" BackgroundColor="#E9ECEF" TextColor="#495057" FontSize="12" HeightRequest="34" CornerRadius="8" Padding="12,0"/>
                        <Button x:Name="FilterDryBtn" Text="🌵 Сухо (&lt;45%)" Clicked="OnFilterDryClicked" BackgroundColor="#E9ECEF" TextColor="#495057" FontSize="12" HeightRequest="34" CornerRadius="8" Padding="12,0"/>
                    </HorizontalStackLayout>
                </Grid>

                <!-- Список записів -->
                <CollectionView x:Name="ReadingsCollectionView"
                                SelectionMode="Single"
                                SelectionChanged="OnReadingSelected"
                                HeightRequest="380"
                                EmptyView="Немає записів за обраним фільтром або сервер ще не надіслав дані.">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="8"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="shared:SensorReading">
                            <Border BackgroundColor="White" StrokeShape="RoundRectangle 10" Stroke="#E0E0E0" Padding="14,10">
                                <Grid ColumnDefinitions="Auto, *, *, *, Auto" VerticalOptions="Center">
                                    <VerticalStackLayout Grid.Column="0" WidthRequest="95">
                                        <Label Text="{Binding CreatedAt, StringFormat='{0:HH:mm:ss}'}" FontAttributes="Bold" FontSize="15" TextColor="#212529"/>
                                        <Label Text="{Binding CreatedAt, StringFormat='{0:dd.MM.yyyy}'}" FontSize="11" TextColor="#868E96"/>
                                    </VerticalStackLayout>

                                    <Label Grid.Column="1" Text="{Binding Temperature, StringFormat='🌡️ {0:F1} °C'}" VerticalOptions="Center" HorizontalOptions="Center" FontSize="14" FontAttributes="Bold" TextColor="#1B4332"/>
                                    <Label Grid.Column="2" Text="{Binding SoilHumidity, StringFormat='💧 {0:F1} %'}" VerticalOptions="Center" HorizontalOptions="Center" FontSize="14" FontAttributes="Bold" TextColor="#0077B6"/>
                                    <Label Grid.Column="3" Text="{Binding LightLevel, StringFormat='☀️ {0} lx'}" VerticalOptions="Center" HorizontalOptions="Center" FontSize="14" FontAttributes="Bold" TextColor="#D97706"/>

                                    <Label Grid.Column="4" Text="Деталі ❯" VerticalOptions="Center" FontSize="12" TextColor="#ADB5BD"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>