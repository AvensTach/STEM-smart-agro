<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartAgro.Frontend.MainPage"
             Title="SmartAgro Multi-Object Hub"
             BackgroundColor="#F0F4F1">

    <Grid RowDefinitions="Auto, *" Padding="16" RowSpacing="14">

        <!-- ВЕРХНЯ ПАНЕЛЬ: Статус API + Статус SignalR -->
        <Border Grid.Row="0" BackgroundColor="White" StrokeShape="RoundRectangle 14" Stroke="Transparent" Padding="16,12">
            <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="12" VerticalOptions="Center">
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                    <Label Text="🌱 SmartAgro: Мульти-об'єктний моніторинг" FontSize="20" FontAttributes="Bold" TextColor="#1B4332"/>
                    <HorizontalStackLayout Spacing="12">
                        <Label x:Name="ConnectionStatusLabel" Text="⏳ Завантаження..." FontSize="12" TextColor="#6C757D"/>
                        <Label x:Name="SignalRStatusLabel" Text="⚡ SignalR: Підключення..." FontSize="12" FontAttributes="Bold" TextColor="#D97706"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <Button Grid.Column="1"
                        x:Name="ShowAllObjectsBtn"
                        Text="🌐 Всі об'єкти"
                        Clicked="OnShowAllObjectsClicked"
                        BackgroundColor="#1B4332"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        HeightRequest="40"
                        Padding="14,0"/>

                <Button Grid.Column="2"
                        Text="🔄 Оновити все"
                        Clicked="OnRefreshClicked"
                        BackgroundColor="#E8F5E9"
                        TextColor="#2D6A4F"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        HeightRequest="40"
                        Padding="14,0"/>
            </Grid>
        </Border>

        <!-- ОСНОВНИЙ КОНТЕНТ -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16">

                <!-- 1. КАРТКИ ОБ'ЄКТІВ (ГОРИЗОНТАЛЬНИЙ АБО СІТКОВИЙ ОГЛЯД УСІХ ДАТЧИКІВ) -->
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="🏢 Активні об'єкти (натисни на картку для фільтрації)" FontSize="16" FontAttributes="Bold" TextColor="#1B4332"/>
                        <Label Grid.Column="1" x:Name="SelectedObjectBannerLabel" Text="Обрано: Всі об'єкти" FontSize="13" FontAttributes="Bold" TextColor="#2D6A4F"/>
                    </Grid>

                    <CollectionView x:Name="SensorsOverviewCollection"
                                    SelectionMode="Single"
                                    SelectionChanged="OnSensorCardSelected"
                                    HeightRequest="155"
                                    EmptyView="Об'єкти ще не завантажені (перевірте GET /api/sensors).">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="12"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border WidthRequest="250"
                                        BackgroundColor="{Binding CardBackground}"
                                        StrokeShape="RoundRectangle 14"
                                        Stroke="{Binding CardBorder}"
                                        StrokeThickness="2"
                                        Padding="14">
                                    <VerticalStackLayout Spacing="8">
                                        <!-- Заголовок картки об'єкта -->
                                        <Grid ColumnDefinitions="*, Auto">
                                            <VerticalStackLayout Grid.Column="0">
                                                <Label Text="{Binding SensorName}" FontSize="16" FontAttributes="Bold" TextColor="#1B4332" LineBreakMode="TailTruncation"/>
                                                <Label Text="{Binding SensorId, StringFormat='ID об’єкта: #{0}'}" FontSize="11" TextColor="#6C757D"/>
                                            </VerticalStackLayout>
                                            <Border Grid.Column="1" BackgroundColor="{Binding BadgeColor}" StrokeShape="RoundRectangle 8" Stroke="Transparent" Padding="8,4" VerticalOptions="Start">
                                                <Label Text="{Binding StatusText}" FontSize="11" FontAttributes="Bold" TextColor="White"/>
                                            </Border>
                                        </Grid>

                                        <BoxView HeightRequest="1" Color="#E9ECEF"/>

                                        <!-- Останні показники цього конкретного об'єкта -->
                                        <Grid ColumnDefinitions="*, *, *" ColumnSpacing="4">
                                            <VerticalStackLayout Grid.Column="0">
                                                <Label Text="Темп." FontSize="10" TextColor="#6C757D"/>
                                                <Label Text="{Binding TempDisplay}" FontSize="14" FontAttributes="Bold" TextColor="#1B4332"/>
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="1">
                                                <Label Text="Вологість" FontSize="10" TextColor="#6C757D"/>
                                                <Label Text="{Binding HumDisplay}" FontSize="14" FontAttributes="Bold" TextColor="#0077B6"/>
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="2">
                                                <Label Text="Світло" FontSize="10" TextColor="#6C757D"/>
                                                <Label Text="{Binding LightDisplay}" FontSize="14" FontAttributes="Bold" TextColor="#D97706"/>
                                            </VerticalStackLayout>
                                        </Grid>

                                        <Label Text="{Binding LastUpdatedDisplay}" FontSize="10" TextColor="#868E96" HorizontalOptions="End"/>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- 2. ІНТЕРАКТИВНИЙ ТЕСТЕР-СИМУЛЯТОР З ВИБОРОМ ОБ'ЄКТА ТА API KEY -->
                <Border BackgroundColor="White" StrokeShape="RoundRectangle 14" Stroke="#E9ECEF" Padding="14">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="🎛️ Ручна відправка показників на конкретний об'єкт (POST + ApiKey)" FontSize="15" FontAttributes="Bold" TextColor="#1B4332"/>
                                <Label Text="Зміни показники та відправ їх через захищений ендпоінт — SignalR миттєво оновить картку" FontSize="12" TextColor="#6C757D"/>
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    x:Name="ToggleSimulatorBtn"
                                    Text="Розгорнути ▼"
                                    Clicked="OnToggleSimulatorClicked"
                                    BackgroundColor="#E8F5E9"
                                    TextColor="#2D6A4F"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    CornerRadius="8"
                                    HeightRequest="34"/>
                        </Grid>

                        <VerticalStackLayout x:Name="SimulatorPanel" IsVisible="False" Spacing="10" Padding="0,8,0,0">
                            <BoxView HeightRequest="1" Color="#E9ECEF"/>

                            <!-- Вибір об'єкта та введення X-Api-Key -->
                            <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="Обери об'єкт (Sensor):" FontSize="12" FontAttributes="Bold" TextColor="#495057"/>
                                    <Picker x:Name="SimSensorPicker" Title="Оберіть об'єкт..." ItemDisplayBinding="{Binding Name}" BackgroundColor="#F8F9FA"/>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="X-Api-Key (з твоїх User Secrets / appsettings):" FontSize="12" FontAttributes="Bold" TextColor="#495057"/>
                                    <Entry x:Name="ApiKeyEntry" Placeholder="Введи свій ApiKey для POST..." BackgroundColor="#F8F9FA"/>
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Слайдери -->
                            <Grid ColumnDefinitions="150, *, 75" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="🌡️ Температура:" VerticalOptions="Center" FontSize="13"/>
                                <Slider Grid.Column="1" x:Name="SimTempSlider" Minimum="5" Maximum="45" Value="24" MinimumTrackColor="#E63946" ValueChanged="OnSimSliderChanged"/>
                                <Label Grid.Column="2" x:Name="SimTempValueLabel" Text="24.0 °C" FontAttributes="Bold" HorizontalTextAlignment="End" VerticalOptions="Center"/>
                            </Grid>

                            <Grid ColumnDefinitions="150, *, 75" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="💧 Вологість ґрунту:" VerticalOptions="Center" FontSize="13"/>
                                <Slider Grid.Column="1" x:Name="SimHumSlider" Minimum="10" Maximum="95" Value="55" MinimumTrackColor="#0096C7" ValueChanged="OnSimSliderChanged"/>
                                <Label Grid.Column="2" x:Name="SimHumValueLabel" Text="55.0 %" FontAttributes="Bold" HorizontalTextAlignment="End" VerticalOptions="Center"/>
                            </Grid>

                            <Grid ColumnDefinitions="150, *, 75" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="☀️ Освітлення:" VerticalOptions="Center" FontSize="13"/>
                                <Slider Grid.Column="1" x:Name="SimLightSlider" Minimum="50" Maximum="1000" Value="500" MinimumTrackColor="#F59E0B" ValueChanged="OnSimSliderChanged"/>
                                <Label Grid.Column="2" x:Name="SimLightValueLabel" Text="500 lx" FontAttributes="Bold" HorizontalTextAlignment="End" VerticalOptions="Center"/>
                            </Grid>

                            <Button Text="🚀 Надіслати телеметрію на обраний об'єкт"
                                    Clicked="OnSendCustomReadingClicked"
                                    BackgroundColor="#1B4332"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    CornerRadius="10"
                                    HeightRequest="42"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- 3. ІСТОРІЯ ПОКАЗНИКІВ З ФІЛЬТРАМИ ЗА ОБ'ЄКТОМ ТА КРИТИЧНІСТЮ -->
                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                    <VerticalStackLayout Grid.Column="0">
                        <Label x:Name="HistoryHeaderLabel" Text="📋 Історія телеметрії (Всі об'єкти)" FontSize="17" FontAttributes="Bold" TextColor="#1B4332"/>
                        <Label Text="Клікни на картку об'єкта вище, щоб відфільтрувати список по конкретній локації" FontSize="12" TextColor="#6C757D"/>
                    </VerticalStackLayout>

                    <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                        <Button x:Name="FilterAllBtn" Text="Всі стани" Clicked="OnFilterAllClicked" BackgroundColor="#2D6A4F" TextColor="White" FontSize="12" HeightRequest="34" CornerRadius="8" Padding="12,0"/>
                        <Button x:Name="FilterHotBtn" Text="🔥 Спека (>28°C)" Clicked="OnFilterHotClicked" BackgroundColor="#E9ECEF" TextColor="#495057" FontSize="12" HeightRequest="34" CornerRadius="8" Padding="12,0"/>
                        <Button x:Name="FilterDryBtn" Text="🌵 Сухо (&lt;45%)" Clicked="OnFilterDryClicked" BackgroundColor="#E9ECEF" TextColor="#495057" FontSize="12" HeightRequest="34" CornerRadius="8" Padding="12,0"/>
                    </HorizontalStackLayout>
                </Grid>

                <CollectionView x:Name="ReadingsCollectionView"
                                SelectionMode="Single"
                                SelectionChanged="OnReadingSelected"
                                HeightRequest="360"
                                EmptyView="Немає записів для обраного об'єкта або фільтра.">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="8"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="White" StrokeShape="RoundRectangle 10" Stroke="#E0E0E0" Padding="14,10">
                                <Grid ColumnDefinitions="140, 95, *, *, *, Auto" VerticalOptions="Center">
                                    <!-- Назва об'єкта -->
                                    <Border Grid.Column="0" BackgroundColor="#E8F5E9" StrokeShape="RoundRectangle 6" Stroke="Transparent" Padding="8,4" HorizontalOptions="Start" VerticalOptions="Center">
                                        <Label Text="{Binding SensorName}" FontSize="12" FontAttributes="Bold" TextColor="#1B4332" LineBreakMode="TailTruncation"/>
                                    </Border>

                                    <!-- Час -->
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="{Binding CreatedAt, StringFormat='{0:HH:mm:ss}'}" FontAttributes="Bold" FontSize="14" TextColor="#212529"/>
                                        <Label Text="{Binding CreatedAt, StringFormat='{0:dd.MM.yyyy}'}" FontSize="11" TextColor="#868E96"/>
                                    </VerticalStackLayout>

                                    <Label Grid.Column="2" Text="{Binding Temperature, StringFormat='🌡️ {0:F1} °C'}" VerticalOptions="Center" HorizontalOptions="Center" FontSize="14" FontAttributes="Bold" TextColor="#1B4332"/>
                                    <Label Grid.Column="3" Text="{Binding SoilHumidity, StringFormat='💧 {0:F1} %'}" VerticalOptions="Center" HorizontalOptions="Center" FontSize="14" FontAttributes="Bold" TextColor="#0077B6"/>
                                    <Label Grid.Column="4" Text="{Binding LightLevel, StringFormat='☀️ {0:F0} lx'}" VerticalOptions="Center" HorizontalOptions="Center" FontSize="14" FontAttributes="Bold" TextColor="#D97706"/>

                                    <Label Grid.Column="5" Text="Деталі ❯" VerticalOptions="Center" FontSize="12" TextColor="#ADB5BD"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>