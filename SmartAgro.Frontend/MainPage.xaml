<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             x:Class="SmartAgro.Frontend.MainPage"
             Title="SmartAgro Multi-Object Hub"
             BackgroundColor="#F0F4F1">

    <Grid RowDefinitions="Auto, *" Padding="16" RowSpacing="14">
        <Border Grid.Row="0" BackgroundColor="White" StrokeShape="RoundRectangle 14" Stroke="Transparent" Padding="16,12">
            <Grid ColumnDefinitions="*, Auto, Auto, Auto" ColumnSpacing="12" VerticalOptions="Center">
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                    <Label Text="SmartAgro: Мульти-об'єктний моніторинг" FontSize="20" FontAttributes="Bold" TextColor="#1B4332"/>
                    <HorizontalStackLayout Spacing="12">
                        <Label x:Name="ConnectionStatusLabel" Text="Завантаження..." FontSize="12" TextColor="#6C757D"/>
                        <Label x:Name="SignalRStatusLabel" Text="SignalR: Підключення..." FontSize="12" FontAttributes="Bold" TextColor="#D97706"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <Button Grid.Column="1" x:Name="ShowAllObjectsBtn" Text="Всі об'єкти" Clicked="OnShowAllObjectsClicked" BackgroundColor="#1B4332" TextColor="White" FontAttributes="Bold" CornerRadius="10" HeightRequest="40" Padding="14,0"/>
                <Button Grid.Column="2" Text="Оновити все" Clicked="OnRefreshClicked" BackgroundColor="#E8F5E9" TextColor="#2D6A4F" FontAttributes="Bold" CornerRadius="10" HeightRequest="40" Padding="14,0"/>
                <Button Grid.Column="3" Text="Вийти" Clicked="OnLogoutClicked" BackgroundColor="#E63946" TextColor="White" FontAttributes="Bold" CornerRadius="10" HeightRequest="40" Padding="14,0"/>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16">

                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="Активні об'єкти (натисни на картку для фільтрації)" FontSize="16" FontAttributes="Bold" TextColor="#1B4332"/>
                        <Label Grid.Column="1" x:Name="SelectedObjectBannerLabel" Text="Обрано: Всі об'єкти" FontSize="13" FontAttributes="Bold" TextColor="#2D6A4F"/>
                    </Grid>

                    <CollectionView x:Name="SensorsOverviewCollection" SelectionMode="Single" SelectionChanged="OnSensorCardSelected" HeightRequest="155">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="12"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border WidthRequest="250" BackgroundColor="{Binding CardBackground}" StrokeShape="RoundRectangle 14" Stroke="{Binding CardBorder}" StrokeThickness="2" Padding="14">
                                    <VerticalStackLayout Spacing="8">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <VerticalStackLayout Grid.Column="0">
                                                <Label Text="{Binding SensorName}" FontSize="16" FontAttributes="Bold" TextColor="#1B4332" LineBreakMode="TailTruncation"/>
                                                <Label Text="{Binding SensorId, StringFormat='ID об’єкта: #{0}'}" FontSize="11" TextColor="#6C757D"/>
                                            </VerticalStackLayout>
                                            <Border Grid.Column="1" BackgroundColor="{Binding BadgeColor}" StrokeShape="RoundRectangle 8" Stroke="Transparent" Padding="8,4" VerticalOptions="Start">
                                                <Label Text="{Binding StatusText}" FontSize="11" FontAttributes="Bold" TextColor="White"/>
                                            </Border>
                                        </Grid>

                                        <BoxView HeightRequest="1" Color="#E9ECEF"/>

                                        <Grid ColumnDefinitions="*, *, *" ColumnSpacing="4">
                                            <VerticalStackLayout Grid.Column="0">
                                                <Label Text="Темп." FontSize="10" TextColor="#6C757D"/>
                                                <Label Text="{Binding TempDisplay}" FontSize="14" FontAttributes="Bold" TextColor="#1B4332"/>
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="1">
                                                <Label Text="Вологість" FontSize="10" TextColor="#6C757D"/>
                                                <Label Text="{Binding HumDisplay}" FontSize="14" FontAttributes="Bold" TextColor="#0077B6"/>
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="2">
                                                <Label Text="Світло" FontSize="10" TextColor="#6C757D"/>
                                                <Label Text="{Binding LightDisplay}" FontSize="14" FontAttributes="Bold" TextColor="#D97706"/>
                                            </VerticalStackLayout>
                                        </Grid>

                                        <Label Text="{Binding LastUpdatedDisplay}" FontSize="10" TextColor="#868E96" HorizontalOptions="End"/>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                
                <Border BackgroundColor="White" StrokeShape="RoundRectangle 14" Stroke="#E9ECEF" Padding="14">
                    <VerticalStackLayout Spacing="12">
                        <VerticalStackLayout>
                            <Label Text="Додати новий об'єкт" FontSize="15" FontAttributes="Bold" TextColor="#1B4332"/>
                            <Label Text="Введіть назву об'єкта. Він буде автоматично прив'язаний до вашого акаунту." FontSize="12" TextColor="#6C757D"/>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="#E9ECEF"/>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Назва об'єкта:" FontSize="12" FontAttributes="Bold" TextColor="#495057"/>
                            <Entry x:Name="NewSensorNameEntry" Placeholder="Напр. Теплиця 2..." BackgroundColor="#F8F9FA" TextColor="#495057"/>
                        </VerticalStackLayout>

                        <Button Text="Додати об'єкт" Clicked="OnAddNewSensorClicked" BackgroundColor="#1B4332" TextColor="White" FontAttributes="Bold" CornerRadius="10" HeightRequest="42"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Панель графіків -->
                <VerticalStackLayout x:Name="ChartsPanel" IsVisible="False" Spacing="8">
                    <Label Text="Динаміка показників" FontSize="16" FontAttributes="Bold" TextColor="#1B4332"/>
                    <Grid ColumnDefinitions="*, *" HeightRequest="210" ColumnSpacing="12">
                        <Border Grid.Column="0" BackgroundColor="White" StrokeShape="RoundRectangle 12" Stroke="#E0E0E0" Padding="8">
                            <VerticalStackLayout>
                                <Label Text="Температура (°C)" FontSize="12" FontAttributes="Bold" TextColor="#6C757D" HorizontalOptions="Center"/>
                                <lvc:CartesianChart Series="{Binding TempSeries}" XAxes="{Binding XAxes}" HeightRequest="160"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" BackgroundColor="White" StrokeShape="RoundRectangle 12" Stroke="#E0E0E0" Padding="8">
                            <VerticalStackLayout>
                                <Label Text="Вологість ґрунту (%)" FontSize="12" FontAttributes="Bold" TextColor="#6C757D" HorizontalOptions="Center"/>
                                <lvc:CartesianChart Series="{Binding HumSeries}" XAxes="{Binding XAxes}" HeightRequest="160"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>

                <!-- Історія та фільтри -->
                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                    <VerticalStackLayout Grid.Column="0">
                        <Label x:Name="HistoryHeaderLabel" Text="Історія телеметрії (Всі об'єкти)" FontSize="17" FontAttributes="Bold" TextColor="#1B4332"/>
                        <Label Text="Клікни на картку об'єкта вище, щоб відфільтрувати список по конкретній локації" FontSize="12" TextColor="#6C757D"/>
                    </VerticalStackLayout>

                    <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                        <Button x:Name="FilterAllBtn" Text="Всі стани" Clicked="OnFilterAllClicked" BackgroundColor="#2D6A4F" TextColor="White" FontSize="12" HeightRequest="34" CornerRadius="8" Padding="12,0"/>
                        <Button x:Name="FilterHotBtn" Text="Спека (>28°C)" Clicked="OnFilterHotClicked" BackgroundColor="#E9ECEF" TextColor="#495057" FontSize="12" HeightRequest="34" CornerRadius="8" Padding="12,0"/>
                        <Button x:Name="FilterDryBtn" Text="Сухо (&lt;45%)" Clicked="OnFilterDryClicked" BackgroundColor="#E9ECEF" TextColor="#495057" FontSize="12" HeightRequest="34" CornerRadius="8" Padding="12,0"/>
                    </HorizontalStackLayout>
                </Grid>

                <CollectionView x:Name="ReadingsCollectionView" SelectionMode="Single" SelectionChanged="OnReadingSelected" HeightRequest="360">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="8"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="White" StrokeShape="RoundRectangle 10" Stroke="#E0E0E0" Padding="14,10">
                                <Grid ColumnDefinitions="140, 95, *, *, *, Auto" VerticalOptions="Center">
                                    <Border Grid.Column="0" BackgroundColor="#E8F5E9" StrokeShape="RoundRectangle 6" Stroke="Transparent" Padding="8,4" HorizontalOptions="Start" VerticalOptions="Center">
                                        <Label Text="{Binding SensorName}" FontSize="12" FontAttributes="Bold" TextColor="#1B4332" LineBreakMode="TailTruncation"/>
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="{Binding CreatedAt, StringFormat='{0:HH:mm:ss}'}" FontAttributes="Bold" FontSize="14" TextColor="#212529"/>
                                        <Label Text="{Binding CreatedAt, StringFormat='{0:dd.MM.yyyy}'}" FontSize="11" TextColor="#868E96"/>
                                    </VerticalStackLayout>

                                    <Label Grid.Column="2" Text="{Binding Temperature, StringFormat='{0:F1} °C'}" VerticalOptions="Center" HorizontalOptions="Center" FontSize="14" FontAttributes="Bold" TextColor="#1B4332"/>
                                    <Label Grid.Column="3" Text="{Binding SoilHumidity, StringFormat='{0:F1} %'}" VerticalOptions="Center" HorizontalOptions="Center" FontSize="14" FontAttributes="Bold" TextColor="#0077B6"/>
                                    <Label Grid.Column="4" Text="{Binding LightLevel, StringFormat='{0:F0} lx'}" VerticalOptions="Center" HorizontalOptions="Center" FontSize="14" FontAttributes="Bold" TextColor="#D97706"/>

                                    <Label Grid.Column="5" Text="Деталі >" VerticalOptions="Center" FontSize="12" TextColor="#ADB5BD"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>