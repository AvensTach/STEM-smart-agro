<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartAgro.Frontend.LoginPage"
             Title="Вхід у SmartAgro"
             BackgroundColor="#F0F4F1">

    <Grid VerticalOptions="Center" Padding="30">
        <Border BackgroundColor="White" StrokeShape="RoundRectangle 14" Stroke="#E0E0E0" Padding="24">
            <VerticalStackLayout Spacing="16">

                <Label Text="SmartAgro" FontSize="24" FontAttributes="Bold" TextColor="#1B4332" HorizontalOptions="Center"/>
                <Label Text="Увійдіть, щоб керувати об'єктами" FontSize="14" TextColor="#6C757D" HorizontalOptions="Center" Margin="0,0,0,10"/>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Ім'я користувача (Username)" FontSize="12" FontAttributes="Bold" TextColor="#000000"/>
                    <Entry x:Name="UsernameEntry" Placeholder="Введіть логін..." BackgroundColor="#F8F9FA" TextColor="#000000"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Пароль" FontSize="12" FontAttributes="Bold" TextColor="#000000"/>
                    <Entry x:Name="PasswordEntry" Placeholder="Введіть пароль..." IsPassword="True" BackgroundColor="#F8F9FA" TextColor="#000000"/>
                </VerticalStackLayout>

                <Button x:Name="LoginBtn" Text="Увійти" Clicked="OnLoginClicked" BackgroundColor="#1B4332" TextColor="White" FontAttributes="Bold" CornerRadius="10" HeightRequest="45" Margin="0,10,0,0"/>

                <Button x:Name="RegisterBtn" Text="Створити новий акаунт" Clicked="OnRegisterClicked" BackgroundColor="Transparent" TextColor="#2D6A4F" FontAttributes="Bold" HeightRequest="40"/>

            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>