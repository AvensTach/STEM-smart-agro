FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY ["SmartAgro.IoT/SmartAgro.IoT.csproj", "SmartAgro.IoT/"]
COPY ["SmartAgro.Shared/SmartAgro.Shared.csproj", "SmartAgro.Shared/"]
RUN dotnet restore "SmartAgro.IoT/SmartAgro.IoT.csproj"

COPY . .
WORKDIR "/src/SmartAgro.IoT"
RUN dotnet publish "SmartAgro.IoT.csproj" -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/runtime:8.0 AS final
WORKDIR /app


COPY --from=build /app/publish .

USER app

ENTRYPOINT ["dotnet", "SmartAgro.IoT.dll"]
