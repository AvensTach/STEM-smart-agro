[*.cs]
# CA1305: Ignore localization requirements for formatting strings/numbers
dotnet_diagnostic.CA1305.severity = none

# CA1304: Ignore culture specification requirements for string operations
dotnet_diagnostic.CA1304.severity = none

# CA1848: Ignore high-performance logging delegate requirements
dotnet_diagnostic.CA1848.severity = none

# CA2254: Ignore strict logging template requirements
dotnet_diagnostic.CA2254.severity = none

# Ignore strict Naming and Globalization warnings for CI/CD builds
dotnet_diagnostic.CA1307.severity = none
dotnet_diagnostic.CA1309.severity = none